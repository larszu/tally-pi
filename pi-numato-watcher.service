[Unit]
Description=tally-pi Numato USB GPIO watcher (hot-plug)
After=network.target companion.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/pi-guide/numato_watcher.py
WorkingDirectory=/opt/pi-guide
Restart=always
RestartSec=3
User=root
RuntimeDirectory=pi-guide

[Install]
WantedBy=multi-user.target
