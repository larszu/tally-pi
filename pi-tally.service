[Unit]
Description=pi-tally — tally output driver + trigger button handler
After=network.target pi-atem-watcher.service
Wants=pi-atem-watcher.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/pi-guide/pi-tally.py
WorkingDirectory=/opt/pi-guide
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
