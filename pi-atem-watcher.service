[Unit]
Description=ATEM state watcher and command sender for pi-guide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/pi-guide/atem_watcher.py
Restart=always
RestartSec=3
# /run/pi-guide for atem.json (state) and atem-cmd.sock (command socket).
RuntimeDirectory=pi-guide
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
